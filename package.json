{
  "name": "repro-payload-admin-branco",
  "version": "1.0.0",
  "description": "Reprodução mínima: painel do Payload renderiza em branco na Vercel",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.87.1",
    "@payloadcms/next": "3.87.1",
    "@payloadcms/richtext-lexical": "3.87.1",
    "@payloadcms/translations": "3.87.1",
    "@payloadcms/ui": "3.87.1",
    "cross-env": "^7.0.3",
    "graphql": "^16.8.1",
    "next": "16.3.0",
    "payload": "3.87.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.2"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "24.x"
  }
}
